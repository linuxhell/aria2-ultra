upstream/libtool
upstream/stamp-h1
upstream/autom4te.cache/
upstream/aclocal.m4
upstream/**/.deps/
upstream/**/.libs/
upstream/**/*.o
upstream/**/*.lo
upstream/**/*.la
upstream/src/aria2c
upstream/src/aria2c.exe
upstream/instroot/
